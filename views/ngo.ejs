          location: "Kukatpally",
        },
      ];

      // Display all NGOs initially
      function displayNGOs(ngoList) {
        if (ngoList.length === 0) {
          document.querySelector("#people").innerHTML = '<div class="no-results">No NGOs found matching your criteria.</div>';
          return;
        }

        let yo = "";
        ngoList.forEach((e) => {
          yo += `
            <div class="person">
              <img src="${e.src}" alt="${e.name}" title="${e.name}"> 
              <h4>${e.name}</h4>
            </div>
          `;
        });
        document.querySelector("#people").innerHTML = yo;
        addClickListener();
      }

      // Initial display
      displayNGOs(data);

      // Search functionality
      const searchInput = document.getElementById("searchInput");
      const locationSelect = document.getElementById("location");

      function filterNGOs() {
        const searchTerm = searchInput.value.toLowerCase();
        const locationTerm = locationSelect.value.toLowerCase();

        let filtered = data.filter((e) => {
          const matchesSearch = e.name.toLowerCase().includes(searchTerm);
          const matchesLocation = locationTerm === "none" || e.location.toLowerCase().startsWith(locationTerm);
          return matchesSearch && matchesLocation;
        });

        displayNGOs(filtered);
      }

      searchInput.addEventListener("input", filterNGOs);
      locationSelect.addEventListener("change", filterNGOs);

      function addClickListener() {
        document.querySelectorAll(".person").forEach((item) => {
          item.addEventListener("click", function () {
            let name = this.querySelector("h4").textContent;
            window.location.href = `/person?name=${encodeURIComponent(
              name
            )}&restaurant=${encodeURIComponent(restaurant)}`;
          });
        });
      }
    </script>
  </body>
</html>

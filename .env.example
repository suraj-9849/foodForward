# --------------------------
# For local development, use http://localhost:3000
# For production, use your deployed URL (e.g., https://yourapp.com)
BASE_URL=http://localhost:3000

# MongoDB Configuration
# ----------------------
# Get your connection string from MongoDB Atlas: https://cloud.mongodb.com/
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
#
# Steps to get your MongoDB connection string:
# 1. Log in to MongoDB Atlas (https://cloud.mongodb.com/)
# 2. Click "Connect" on your cluster
# 3. Choose "Connect your application"
# 4. Copy the connection string and replace <password> with your database password
# 5. Replace <database> with your database name (e.g., LoginandSignIn)
DATABASE_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/DatabaseName?retryWrites=true&w=majority

# Optional Configuration
# -----------------------
# Uncomment and configure these for production deployments

# Session Secret (recommended for production)
# Generate a strong random string for production use
# SESSION_SECRET=your_random_secret_string_here

# Node Environment
# Set to "production" when deploying
# NODE_ENV=development

# Server Port (optional, defaults to 3000)
# PORT=3000
